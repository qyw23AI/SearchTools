<?xml version="1.0" encoding="utf-8" ?>
<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:em="http://www.mozilla.org/2004/em-rdf#">
  <Description about="urn:mozilla:install-manifest">
    <em:name>SearchTools Evidence Bridge</em:name>
    <em:description>Zotero bridge for SearchTools: exact page navigation, temporary evidence highlighting, and reverse card creation.</em:description>
    <em:bootstrap>true</em:bootstrap>
    <em:id>evidence-bridge@searchtools.org</em:id>
    <em:version>1.2.2</em:version>
    <em:creator>SearchTools</em:creator>
    <em:type>2</em:type>
    <em:targetApplication>
      <Description>
        <em:id>zotero@zotero.org</em:id>
        <em:minVersion>6.999</em:minVersion>
        <em:maxVersion>9999.*</em:maxVersion>
      </Description>
      <Description>
        <em:id>zotero@chnm.gmu.edu</em:id>
        <em:minVersion>5.0.79</em:minVersion>
        <em:maxVersion>9999.*</em:maxVersion>
      </Description>
    </em:targetApplication>
  </Description>
</RDF>
